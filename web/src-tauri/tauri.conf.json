{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Practice ESP Ambient Lighting",
  "version": "0.1.0",
  "identifier": "dev.practiceesp.ambientlighting",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Practice ESP Ambient Lighting",
        "width": 940,
        "height": 900,
        "minWidth": 620,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Desktop companion for ESP32 ambient lighting"
  }
}
